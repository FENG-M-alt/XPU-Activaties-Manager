# =============================================================================
# 劳动活动签到系统 · 后端配置模板
# =============================================================================
# 使用方法
#   1. 复制本文件为 .env：Copy-Item .env.example .env
#   2. 按需修改 .env 中的值；本文件保持为模板，不要直接改它当配置用。
#
# 读取规则（与 app/config.py 的解析器一致）
#   · 环境变量优先于 .env，同名时以环境变量为准。
#   · 注释必须【独占一行】，值后面不要写注释——解析器不会剥离行内注释，
#     `DEBUG=true  # 说明` 会把整串 "true  # 说明" 当成值。
#   · 值不需要加引号；被引号包裹时会自动去掉一层引号，值中的空格会保留。
#   · 删除或留空某项时，回退到 app/config.py 中的默认值（下面各项"默认"即该值）。
#
# 标注说明
#   ⚠️  生产环境必须确认/修改的项
# =============================================================================


# -----------------------------------------------------------------------------
# 基础信息
# -----------------------------------------------------------------------------

# 作用：服务名称。显示在 OpenAPI 文档标题、/docs 页面标题与启动日志中。
# 默认：劳动活动签到系统 后端 API
# 说明：可加环境后缀区分（如"…（测试环境）"），不影响任何业务逻辑。
APP_NAME=劳动活动签到系统 后端 API

# 作用：接口版本号。写入 OpenAPI 的 version 字段，也是 /api/v1/health 返回的 version。
# 默认：1.0.0
# 说明：随接口契约版本升级（文档 1.3：破坏性变更升级版本号），不是每次发版都要改。
APP_VERSION=1.0.0

# 作用：调试模式开关。当前唯一生效点：GET /me 是否返回未脱敏手机号 mobile_raw。
# 默认：true（本地开发方便查看自己的完整手机号）
# ⚠️ 生产必须改为 false，否则学生可在 /me 拿到自己未经脱敏的手机号。
# 说明：不会向客户端暴露堆栈或 SQL，错误响应始终是统一信封。
DEBUG=true

# 作用：全部接口的路径前缀，路由挂载、分享链接拼接、OpenAPI 文档均使用它。
# 默认：/api/v1（文档 1.1 约定）
# 说明：修改后前端所有请求地址需同步调整，一般不要动；版本升级时改为 /api/v2。
API_PREFIX=/api/v1


# -----------------------------------------------------------------------------
# 数据库
# -----------------------------------------------------------------------------

# 作用：SQLAlchemy 数据库连接串，决定使用哪种数据库。
# 默认：sqlite:///lab_checkin.db（相对路径按"启动目录"解析，故请在项目根目录启动）
# 可选写法：
#   MySQL：      mysql+pymysql://user:pass@127.0.0.1:3306/lab_checkin?charset=utf8mb4
#   PostgreSQL： postgresql+psycopg://user:pass@127.0.0.1:5432/lab_checkin
# ⚠️ 切换到 MySQL/PostgreSQL 前需自行安装驱动（pip install pymysql / psycopg），
#    requirements.txt 未内置；且建表仍走 create_all，生产建议改用迁移工具。
DATABASE_URL=sqlite:///lab_checkin.db

# 作用：是否把每条执行的 SQL 打印到控制台（SQLAlchemy echo）。
# 默认：false
# 说明：排查慢查询/生成的 SQL 时临时设为 true；开启后日志量大且会暴露参数，生产关闭。
SQL_ECHO=false


# -----------------------------------------------------------------------------
# 认证与会话（文档 2.2 / 第 3 章）
# -----------------------------------------------------------------------------

# 作用：JWT 签名密钥，用于签发与校验 access token / 下载令牌。
# 默认值仅为占位（change-me-to-a-long-random-string），不可用于任何真实环境。
# ⚠️ 生产必须改为 32 位以上随机串，例如：
#      python -c "import secrets;print(secrets.token_urlsafe(48))"
# 说明：泄露即可伪造任意身份的令牌；修改后所有已发放令牌立即失效（用户需重新登录）。
JWT_SECRET=change-me-to-a-long-random-string

# 作用：JWT 签名算法。
# 默认：HS256（对称密钥，单服务部署足够）
# 说明：仅当接入统一密钥管理 / 多服务互信时才考虑改为 RS256 等非对称算法，需同步改代码。
JWT_ALGORITHM=HS256

# 作用：access token 有效期，单位【秒】。
# 默认：7200（2 小时，文档 2.2 约定）
# 说明：越短越安全但刷新越频繁；前端用 expires_in 判断何时调 /auth/refresh。
ACCESS_TOKEN_TTL=7200

# 作用：refresh token 有效期，单位【秒】。由服务端写入 HttpOnly Cookie。
# 默认：604800（7 天，文档 2.2 约定）
# 说明：到期后必须重新登录；刷新令牌只延长 access token，不会延长本期限。
REFRESH_TOKEN_TTL=604800

# 作用：同一账号最多保留的有效会话数。新建会话超出后，最早的会话被自动撤销。
# 默认：3（文档 2.2 约定）
# 说明：调大意味着同一账号可在更多设备同时在线；调为 1 即"单点登录"效果。
MAX_SESSIONS_PER_ACCOUNT=3

# 作用：存放 refresh token 的 Cookie 名称。
# 默认：refresh_token
# 说明：前后端无需硬编码该名称（Cookie 由服务端读写）；仅在与其他系统共用域名、
#   需要避免 Cookie 冲突时才修改。
REFRESH_COOKIE_NAME=refresh_token

# 作用：refresh token Cookie 是否只允许 HTTPS 传输（Secure 标志）。
# 默认：false（本地 http://127.0.0.1 调试必须为 false，否则浏览器不回传 Cookie）
# ⚠️ 生产（HTTPS）必须改为 true。
COOKIE_SECURE=false

# 作用：Cookie 的 SameSite 策略，控制跨站请求是否携带该 Cookie。
# 默认：lax（同站请求携带，跨站顶级导航携带 —— 前后端同域或本地联调都适用）
# 可选：strict（最严，跨站跳转也不带）、none（跨站携带，⚠️ 必须同时 COOKIE_SECURE=true 且 HTTPS）
# 说明：前端独立域名且需要跨站携带 Cookie 时才用 none；其余场景建议保持 lax。
COOKIE_SAMESITE=lax


# -----------------------------------------------------------------------------
# 安全策略：登录与签到失败锁定（文档 2.6 / 3.1 / 3.6 / 7.3）
# -----------------------------------------------------------------------------

# 作用：同一账号连续登录失败多少次触发锁定。
# 默认：5（文档 3.1 / 3.6 约定）
# 说明：达到次数后接口返回 40103，并提示剩余锁定时间；成功登录会清零计数窗口。
LOGIN_MAX_FAILURES=5

# 作用：学生登录锁定时长，单位【分钟】；同时也是失败次数的统计窗口长度。
# 默认：10（文档 3.1 约定）
STUDENT_LOCK_MINUTES=10

# 作用：管理员登录锁定时长，单位【分钟】；兼作失败次数统计窗口。
# 默认：15（文档 3.6 约定，比学生更长，因为管理员权限更高）
ADMIN_LOCK_MINUTES=15

# 作用：同一学生对同一活动连续输错签到码多少次触发锁定。
# 默认：5（文档 2.6 / 7.3.2 约定）
CHECKIN_MAX_FAILURES=5

# 作用：签到锁定/统计窗口，单位【分钟】。锁定期间即使输入正确签到码也返回 40909。
# 默认：10（文档"锁定 10 分钟"）
CHECKIN_LOCK_MINUTES=10

# 作用：管理员登录图形验证码有效期，单位【秒】。
# 默认：300（5 分钟，文档 3.6 约定）
# 说明：验证码还是一次性的——校验成功或失败都会立即作废，需重新获取。
CAPTCHA_TTL=300

# 作用：报名与签到接口的幂等窗口，单位【秒】。同用户 + 同路径 + 同参数在此窗口内
#   重复提交，直接返回第一次的结果，不产生第二条记录。
# 默认：5（文档 2.5.1 约定）
# 说明：设得过大，用户"取消后立刻重报"可能被误判为重复；一般保持 5 秒。
IDEMPOTENCY_WINDOW=5


# -----------------------------------------------------------------------------
# 限流（文档 2.6）
# 格式统一为「次数/窗口秒数」，例如 10/60 = 60 秒内最多 10 次；超限返回 42900。
# 计数维度：登录按 IP，签到与写接口按用户 ID，导出按管理员账号。
# 说明：当前为进程内内存计数，多 worker 或多实例部署时各自独立计数，
#   需要精确全局限流时请改用 Redis（见 app/core/guards.py）。
# -----------------------------------------------------------------------------

# 作用：限流总开关。设为 false 时下列所有限流规则全部不生效。
# 默认：true
# 说明：仅本地压测/调试时临时关闭，生产必须为 true。
RATE_LIMIT_ENABLED=true

# 作用：登录接口限流（学生与管理员共用），按客户端 IP 统计。
# 默认：10/60 —— 每分钟 10 次
RATE_LOGIN=10/60

# 作用：签到接口限流，按学生用户统计。
# 默认：10/60 —— 每分钟 10 次
RATE_CHECKIN=10/60

# 作用：导出接口限流（签到表、日志导出），按管理员账号统计。
# 默认：5/3600 —— 每小时 5 次（文档 2.6 约定）
RATE_EXPORT=5/3600

# 作用：其他写接口的兜底限流（报名、取消、审核、补签等），按用户统计。
# 默认：30/60 —— 每分钟 30 次
RATE_WRITE=30/60


# -----------------------------------------------------------------------------
# 文件与导入导出（文档 2.8 / A-21 ~ A-25 / A-32）
# 存储目录不在本文件配置，固定为项目下 storage/{exports,covers,uploads}，
# 需要变更请改 app/config.py 的 EXPORT_DIR / COVER_DIR / UPLOAD_DIR。
# -----------------------------------------------------------------------------

# 作用：学生导入 Excel 的大小上限，单位【字节】。
# 默认：10485760（10MB，文档 2.8 约定）
# 说明：超过直接返回 40001，不会进入解析流程。
MAX_IMPORT_SIZE=10485760

# 作用：学生导入单次最大数据行数。
# 默认：5000（文档 2.8 约定）
# 说明：超出返回 40001；调大可支持更大规模导入，但同步解析耗时也会增加。
MAX_IMPORT_ROWS=5000

# 作用：活动封面上传的大小上限，单位【字节】。同时会校验文件头，仅接受 JPG/PNG。
# 默认：2097152（2MB，文档 2.8 约定）
MAX_COVER_SIZE=2097152

# 作用：学生导入"预览批次"的有效期，单位【秒】。上传解析后需在此期限内调用确认接口。
# 默认：1800（30 分钟，文档 5.10 约定）
# 说明：过期后批次作废，需重新上传；此设计避免长期保留待写入数据。
IMPORT_BATCH_TTL=1800

# 作用：导出文件在服务器上的保留天数，超期后下载接口返回 40400。
# 默认：7（文档 A-32 约定）
# 说明：只影响磁盘占用与可回溯时长，不对导出功能本身有影响。
EXPORT_FILE_TTL_DAYS=7

# 作用：同步导出的行数阈值。超过该行数改为"异步导出"：返回 HTTP 202 + task_id，
#   随后通过 A-32 下载。
# 默认：10000（文档 A-21：≤ 1 万行同步返回文件流）
# 说明：调大意味着更多请求会在请求内生成大文件，可能拖长响应时间。
EXPORT_SYNC_LIMIT=10000

# 作用：下载令牌有效期，单位【秒】。用于 A-32 等接口的 ?token= 免 Header 下载，
#   令牌与账号、路径绑定。
# 默认：1800（30 分钟）
# 说明：令牌泄露后有效时间越短越安全；仅影响下载链接，不影响登录态。
DOWNLOAD_TOKEN_TTL=1800


# -----------------------------------------------------------------------------
# 启动行为
# -----------------------------------------------------------------------------

# 作用：启动时若管理员表为空，自动写入示例数据（默认管理员、示例学生/活动/公告）。
# 默认：true
# ⚠️ 生产必须改为 false，否则会创建 superadmin / Admin@123456 等公开密码的账号。
# 说明：可执行 python -m app.seed 手动触发，同样只在空库时生效。
AUTO_SEED=true

# 作用：开启进程内定时任务，周期性推进活动与报名状态（开始→进行中、结束→已结束、
#   未审核→已拒绝、未签到→缺席）。
# 默认：true
# 说明：读接口本身也会按当前时间惰性校正，关闭本任务只会让"无人访问的活动"状态
#   停留在旧值，不影响正确性，但定时统计的口径会滞后。
# ⚠️ 多实例部署时只应在一个实例开启，否则重复执行（幂等但浪费）。
ENABLE_STATE_TASK=true

# 作用：状态推进任务的执行间隔，单位【秒】。
# 默认：60（文档 7.4：定时任务每分钟推进一次）
# 说明：调小可让状态更及时，但会增加数据库轮询；不建议低于 10 秒。
STATE_TASK_INTERVAL=60

# 作用：日志级别（约定值，取 DEBUG / INFO / WARNING / ERROR）。
# 默认：INFO
# 说明：⚠️ 注意——当前版本该变量仅作为配置项保留，尚未接入 logging 配置，
#   实际日志级别由启动命令决定，例如：
#     uvicorn app.main:app --log-level warning
#   需要统一控制时请在 app/main.py 的启动钩子里调用 logging.basicConfig(level=settings.LOG_LEVEL)。
LOG_LEVEL=INFO


# -----------------------------------------------------------------------------
# 跨域（前后端分离联调；生产请改为具体域名）
# -----------------------------------------------------------------------------

# 作用：允许跨域访问的前端来源，多个用英文逗号分隔（需写完整协议+域名+端口，
#   末尾不要带 /）。
# 默认：本地常用的 5173(Vite) / 3000(React) 四个地址
# 说明：· 只有写在这里的源才能携带 Cookie 调用接口；生产改为真实前端域名。
#   · 若填 *，服务端会自动关闭凭证携带（allow_credentials=false），
#     此时 Cookie 刷新令牌机制不可用，因此不要用 *。
#   · 修改后需重启服务生效。
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
